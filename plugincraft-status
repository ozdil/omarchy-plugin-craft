#!/usr/bin/env python3
import subprocess
import json
import os
import sys

def main():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_path = os.path.join(plugin_dir, "plugincraft-engine")

    try:
        res = subprocess.run([engine_path], capture_output=True, text=True, timeout=2.0)
        data = json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception:
        data = {}

    total = data.get("total_plugins", 0)
    plugins = data.get("plugins", [])

    text = f"󰏖 Eklentiler ({total})"
    
    plug_lines = []
    for p in plugins:
        icon = p.get("icon", "📦")
        name = p.get("name", "")
        plug_lines.append(f"{icon} {name}")

    tooltip = f"⚡ PluginCraft • Omarchy Eklenti Merkezi\n• Kurulu Toplam Eklenti: {total}\n\n" + "\n".join(plug_lines) + "\n\n[Sol Tık] Tüm Eklentiler Menüsünü Aç"
    
    print(json.dumps({
        "text": text,
        "tooltip": tooltip,
        "class": "normal"
    }))

if __name__ == "__main__":
    main()
