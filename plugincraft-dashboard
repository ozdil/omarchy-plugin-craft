#!/usr/bin/env python3
import os
import sys
import subprocess
import json
import select

def get_key():
    if not sys.stdin.isatty():
        try:
            line = sys.stdin.readline()
            return line.strip() if line else 'q'
        except Exception:
            return 'q'

    import termios
    import tty
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            r, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r:
                ch2 = sys.stdin.read(1)
                if ch2 == '[':
                    ch3 = sys.stdin.read(1)
                    if ch3 == 'A': return 'UP'
                    if ch3 == 'B': return 'DOWN'
                    if ch3 == 'C': return 'RIGHT'
                    if ch3 == 'D': return 'LEFT'
            return 'ESC'
        if ch in ('\r', '\n'): return 'ENTER'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def get_installed_plugins():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "plugincraft-engine")
    try:
        res = subprocess.run([engine_bin], capture_output=True, text=True, timeout=2.0)
        return json.loads(res.stdout).get("plugins", []) if res.returncode == 0 else []
    except Exception:
        return []

def get_quick_status(key, path):
    try:
        if key == "monitor-craft":
            eng = os.path.join(path, "monitorcraft-engine")
            res = subprocess.run([eng, "--json"], capture_output=True, text=True, timeout=0.8)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                return f"{data.get('total_monitors', 0)} Ekran • 240Hz (VRR)"
        elif key == "menu-craft":
            return "🎮 GAME GARAJ • 119 Uygulama"
        elif key == "spotify-craft":
            eng = os.path.join(path, "spotifycraft-engine")
            res = subprocess.run([eng, "--json"], capture_output=True, text=True, timeout=0.8)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                st = data.get("status", "STOPPED")
                return f"󰓇 {data.get('title', 'Kapalı')[:22]} ({st})"
        elif key == "cyber-sentinel":
            eng = os.path.join(path, "sentinel-scanner")
            res = subprocess.run([eng], capture_output=True, text=True, timeout=0.8)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                return f"{data.get('total_connections', 0)} Soket • {data.get('status', 'OK')}"
        elif key == "git-radar":
            eng = os.path.join(path, "git-scanner")
            res = subprocess.run([eng], capture_output=True, text=True, timeout=0.8)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                return f"{data.get('today_commits', 0)} Commit • {data.get('total_repos_scanned', 0)} Repo"
        elif key == "cve-radar":
            return "Arch Linux Zafiyet Takibi"
        elif key == "omasend":
            return "Yerel Ağ QR Paylaşımı"
        elif key == "badusb-shield":
            return "Kernel HID & USB Sınıf Denetçisi"
        elif key == "auth-watch":
            return "Kimlik Doğrulama Günlüğü"
        elif key == "ghost-mac":
            return "Donanım MAC Gizlilik Denetçisi"
        elif key == "dns-leak-guard":
            return "DNS Çözümleyici Denetimi"
        elif key == "opsec-cleaner":
            return "Metaveri & İz Temizleyici"
        elif key == "tripwire-vault":
            return "Sistem Bütünlük Doğrulama"
    except Exception:
        pass
    return "Hazır & Entegre"

def main():
    plugins = get_installed_plugins()
    if not plugins:
        print("Yüklü eklenti bulunamadı.")
        return

    selected_idx = 0
    
    # Preload statuses
    status_cache = {}
    for p in plugins:
        status_cache[p["key"]] = get_quick_status(p["key"], p.get("path", ""))

    num_buffer = ""

    while True:
        os.system("clear")
        print("\033[1;36m╔══════════════════════════════════════════════════════════════════════════════╗\033[0m")
        print("║  󰏖 \033[1;33mPLUGINCRAFT\033[0m • \033[1;37mOmarchy Eklenti & Kontrol Karargahı\033[0m                        ║")
        print("\033[1;36m╚══════════════════════════════════════════════════════════════════════════════╝\033[0m")
        print(f"  \033[0;90mKlavye: [↑ / ↓ / j / k] Gezin | [1-{len(plugins)}] Numaraya Bas | [Enter] Başlat | [q] Çıkış\033[0m\n")

        for idx, p in enumerate(plugins):
            num_str = f"{idx + 1:02d}"
            icon = p.get("icon", "📦")
            name = p.get("name", "")
            status = status_cache.get(p["key"], "Hazır")

            if idx == selected_idx:
                print(f" \033[1;44;37m ➔ [{num_str}] {icon} {name:<20} \033[1;33m•\033[0;37m {status:<43} \033[0m")
            else:
                print(f"   \033[1;36m[{num_str}]\033[0m {icon} \033[1;37m{name:<20}\033[0m \033[0;90m•\033[0;32m {status:<43}\033[0m")

        print("\n\033[1;36m──────────────────────────────────────────────────────────────────────────────\033[0m")

        key = get_key()

        if key in ('q', 'Q', 'ESC'):
            break
        elif key in ('UP', 'k', 'K'):
            selected_idx = (selected_idx - 1) % len(plugins)
            num_buffer = ""
        elif key in ('DOWN', 'j', 'J'):
            selected_idx = (selected_idx + 1) % len(plugins)
            num_buffer = ""
        elif key == 'ENTER':
            target = plugins[selected_idx]
            cmd = target.get("exec_cmd")
            if cmd and os.path.isfile(cmd):
                os.system("clear")
                subprocess.run([cmd])
                status_cache[target["key"]] = get_quick_status(target["key"], target.get("path", ""))
            num_buffer = ""
        elif key.isdigit():
            num_buffer += key
            val = int(num_buffer)
            if 1 <= val <= len(plugins):
                selected_idx = val - 1
                if val >= 2 or len(num_buffer) >= 2 or len(plugins) < 10:
                    target = plugins[selected_idx]
                    cmd = target.get("exec_cmd")
                    if cmd and os.path.isfile(cmd):
                        os.system("clear")
                        subprocess.run([cmd])
                        status_cache[target["key"]] = get_quick_status(target["key"], target.get("path", ""))
                    num_buffer = ""
            elif len(num_buffer) >= 2:
                num_buffer = ""

if __name__ == "__main__":
    main()
