#!/usr/bin/env python3
import os
import sys
import subprocess
import json
import select
import re

CLEAN_ENV = {
    "PATH": "/usr/bin:/bin",
    "LC_ALL": "C"
}

def get_key():
    if not sys.stdin.isatty():
        try:
            line = sys.stdin.readline()
            return line.strip() if line else 'q'
        except Exception:
            return 'q'

    import termios
    import tty
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            r2, _, _ = select.select([sys.stdin], [], [], 0.05)
            if r2:
                ch2 = sys.stdin.read(1)
                if ch2 == '[':
                    ch3 = sys.stdin.read(1)
                    if ch3 == 'A': return 'UP'
                    if ch3 == 'B': return 'DOWN'
                    if ch3 == 'C': return 'RIGHT'
                    if ch3 == 'D': return 'LEFT'
            return 'ESC'
        if ch in ('\r', '\n'): return 'ENTER'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def get_installed_plugins():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    engine_bin = os.path.join(plugin_dir, "plugincraft-engine")
    try:
        res = subprocess.run([engine_bin], capture_output=True, text=True, timeout=2.0, env=CLEAN_ENV)
        return json.loads(res.stdout).get("plugins", []) if res.returncode == 0 else []
    except Exception:
        return []

def query_plugin_status(p):
    st_cmd = p.get("status_cmd")
    if st_cmd and os.path.isfile(st_cmd) and os.access(st_cmd, os.X_OK):
        try:
            res = subprocess.run([st_cmd], capture_output=True, text=True, timeout=1.0, env=CLEAN_ENV)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                txt = data.get("text", "")
                clean_txt = re.sub(r'[^a-zA-Z0-9_ .:\(\)\[\]-]', '', txt).strip()
                if clean_txt:
                    return clean_txt[:35]
        except Exception:
            pass
    return re.sub(r'[^a-zA-Z0-9_ .:\(\)\[\]-]', '', p.get("description", "Hazir"))[:35]

def main():
    plugins = get_installed_plugins()
    if not plugins:
        os.system("clear")
        print("\033[1;36m╔══════════════════════════════════════════════════════════════════════════════╗\033[0m")
        print("║  󰏖 \033[1;33mPLUGINCRAFT\033[0m • \033[1;37mOmarchy Eklenti Merkezi\033[0m                                    ║")
        print("\033[1;36m╚══════════════════════════════════════════════════════════════════════════════╝\033[0m\n")
        print("  \033[1;33mℹ️  Sistemde henüz kurulu bir harici eklenti bulunamadı.\033[0m\n")
        print("  \033[0;90m[q] Çıkış\033[0m")
        while True:
            k = get_key()
            if k in ('q', 'Q', 'ESC', 'ENTER'):
                break
        return

    selected_idx = 0
    status_cache = {}
    for p in plugins:
        status_cache[p["key"]] = query_plugin_status(p)

    num_buffer = ""

    while True:
        os.system("clear")
        print("\033[1;36m╔══════════════════════════════════════════════════════════════════════════════╗\033[0m")
        print(f"║  󰏖 \033[1;33mPLUGINCRAFT\033[0m • \033[1;37mOmarchy Eklenti & Kontrol Karargahı\033[0m [{len(plugins)} Eklenti Aktif]          ║")
        print("\033[1;36m╚══════════════════════════════════════════════════════════════════════════════╝\033[0m")
        print(f"  \033[0;90mKlavye: [↑ / ↓ / j / k] Gezin | [1-{len(plugins)}] Numaraya Bas | [Enter] Başlat | [q] Çıkış\033[0m\n")

        for idx, p in enumerate(plugins):
            num_str = f"{idx + 1:02d}"
            icon = p.get("icon", "📦")
            name = p.get("name", "")
            status = status_cache.get(p["key"], "Hazır")

            if idx == selected_idx:
                print(f" \033[1;44;37m ➔ [{num_str}] {icon} {name:<18} \033[1;33m•\033[0;37m {status:<45} \033[0m")
            else:
                print(f"   \033[1;36m[{num_str}]\033[0m {icon} \033[1;37m{name:<18}\033[0m \033[0;90m•\033[0;32m {status:<45}\033[0m")

        print("\n\033[1;36m──────────────────────────────────────────────────────────────────────────────\033[0m")

        key = get_key()

        if key in ('q', 'Q', 'ESC'):
            break
        elif key in ('UP', 'k', 'K'):
            selected_idx = (selected_idx - 1) % len(plugins)
            num_buffer = ""
        elif key in ('DOWN', 'j', 'J'):
            selected_idx = (selected_idx + 1) % len(plugins)
            num_buffer = ""
        elif key == 'ENTER':
            target = plugins[selected_idx]
            cmd = target.get("exec_cmd")
            if cmd and os.path.isfile(cmd) and os.access(cmd, os.X_OK):
                os.system("clear")
                subprocess.run([cmd], env=CLEAN_ENV)
                status_cache[target["key"]] = query_plugin_status(target)
            num_buffer = ""
        elif key.isdigit():
            num_buffer += key
            val = int(num_buffer)
            if 1 <= val <= len(plugins):
                selected_idx = val - 1
                if val >= 2 or len(num_buffer) >= 2 or len(plugins) < 10:
                    target = plugins[selected_idx]
                    cmd = target.get("exec_cmd")
                    if cmd and os.path.isfile(cmd) and os.access(cmd, os.X_OK):
                        os.system("clear")
                        subprocess.run([cmd], env=CLEAN_ENV)
                        status_cache[target["key"]] = query_plugin_status(target)
                    num_buffer = ""
            elif len(num_buffer) >= 2:
                num_buffer = ""

if __name__ == "__main__":
    main()
